# ==============================================================================
# EOL Connectors — RHEL 9 production .env
# Stack (Oct 2026): web PHP 8.4.27 | jenkins 2.580.1 LTS + PHP 8.4.27 | MySQL 8.4.13
# ==============================================================================
# Copy to .env on the RHEL server:
#   cp .env.production.sample .env
#   chmod 600 .env      # contains passwords — readable by owner only
#
# Replace every CHANGE_ME_* value. Do not reuse old dev passwords from git history.
# Generate each password with (hex = no shell/SQL special characters):
#   openssl rand -hex 24
#
# Build and start WITHOUT the Mac override file:
#   docker compose -f docker-compose.yml build --no-cache --pull
#   docker compose -f docker-compose.yml up -d
# The jenkins build log must show "PHP 8.4.27" (PHP_MIN_VERSION guard in jenkins/Dockerfile).
#
# Do NOT deploy docker-compose.override.yml on RHEL (it mounts /Volumes).
#
# First-time host setup (run as root on RHEL 9):
#   bash scripts/rhel9-init-dirs.sh
#   chown -R 1000:1000 /opt/eol/jenkins_home /opt/eol/jenkins_tmp
#   semanage fcontext -a -t container_file_t "/opt/eol(/.*)?"   # SELinux, persists across relabels
#   restorecon -Rv /opt/eol
#   (webroot and extra are shared by web + jenkins: if you add mount suffixes, use :z, not :Z)
#
# Docker-published ports bypass firewalld: a port bound to all interfaces is
# reachable even if firewalld does not open it. Bind non-public ports to 127.0.0.1.
# ==============================================================================

# ------------------------------------------------------------------------------
# For EOL PHP 8 codebase: eol_php8_code
# Environment is either development or production
MY_ENVIRONMENT=production
EXTRA_PATH=/opt/eol/extra
# ------------------------------------------------------------------------------
# MySQL
# Database created on first init: eol_production  (from eol_${MY_ENVIRONMENT})
# Root: admin by hand only (docker compose exec db mysql -uroot ...). Not in database.yml or test.php (N3).
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
# App user, created on first init with rights on eol_production only. The PHP code logs in as this user:
# database.yml production + jenkins_production → username: eol_app, password: this MYSQL_PASSWORD.
MYSQL_USER=eol_app
MYSQL_PASSWORD=CHANGE_ME_strong_app_password
MYSQL_DATA_DIR=/opt/eol/mysql_data
# Host port : container port
# Option A — expose only on localhost (recommended):
MYSQL_PORTS=127.0.0.1:4001:3306
# Option B — expose on all interfaces (use firewall to restrict):
# MYSQL_PORTS=4001:3306
# ------------------------------------------------------------------------------
# Apache
# WEBROOT_PATH must contain eol_php8_code and related connector code.
WEBROOT_PATH=/opt/eol/webroot
APACHE_LOGS=/opt/eol/apache2_logs
# editors.eol.org path: browser -HTTPS-> Cloudflare -HTTPS-> 160.111.248.42 (ends HTTPS) -HTTP-> server 10.252.248.39:8080.
# (The old RHEL 7 eol-archive ran Apache natively with `Listen 10.252.248.39:8080`; .42 forwards there.)
# So no TLS cert is needed here. Bind to the server's INTERNAL IP only, so the site isn't reachable
# on its public IP (Docker ports bypass firewalld). In eol-archive (keeps .42 unchanged):
#   WEB_PORTS=10.252.248.39:8080:80
# No clash with JENKINS_PORTS=127.0.0.1:8080:8080 — different address.
# Port 8080 on that IP must be free: don't install/enable the host's own httpd.
# PHP test page from inside the network: http://10.252.248.39:8080/test.php
# Real visitor IPs in logs: Apache trusts X-Forwarded-For only from this proxy (default 10.252.248.42).
# REMOTEIP_PROXY=10.252.248.42
WEB_PORTS=80:80
# Generic default only. Port 80 instead of 8080 needs the network team to re-point .42 to port 80.
# ------------------------------------------------------------------------------
# Jenkins
# Host bind-mount paths. Not JENKINS_HOME: that is the in-container path, set in docker-compose.yml
PATH_JENKINS_TMP=/opt/eol/jenkins_tmp
PATH_JENKINS_HOME=/opt/eol/jenkins_home
# Back up PATH_JENKINS_HOME before every Jenkins upgrade (README → Upgrading Jenkins).
# Jenkins 2.580.1+ no longer bundles 9 plugins; if this server cannot reach updates.jenkins.io,
# copy them into ${PATH_JENKINS_HOME}/plugins/ before the first start (see README).
# Option A — expose only on localhost (recommended); open the UI from your machine via SSH tunnel:
#   ssh -L 8080:127.0.0.1:8080 <user>@<server>   then browse http://localhost:8080
JENKINS_PORTS=127.0.0.1:8080:8080       # Jenkins home page (SSH tunnel)
# Option B — expose on all interfaces (plain HTTP; put a TLS reverse proxy in front):
# JENKINS_PORTS=8080:8080
# Inbound-agent port: not published (no agents; disable it in Jenkins → Security → Agents).
# Only if you add inbound agents: uncomment here AND the matching line in docker-compose.yml.
# JENKINS_PORTS_COMMUNICATION=127.0.0.1:50000:50000
# ------------------------------------------------------------------------------
# Memory limits (M6). Defaults in docker-compose.yml suit the production server (at least 64 GB, ~10 users):
# jenkins 32g, web 6g, db 2g (40 GB total; ~24 GB left for the OS and file cache).
# On a smaller machine (e.g. 16 GB) use 8g / 3g / 1g.
# JENKINS_MEM_LIMIT=32g
# WEB_MEM_LIMIT=6g
# DB_MEM_LIMIT=2g
# ------------------------------------------------------------------------------
# Optional override of full download URL (leave empty for auto):
# Jenkins footer link (M9); default http://dev_connectors.eol.org
# JENKINS_FOOTER_URL=http://dev_connectors.eol.org

# GNPARSER_URL=
# GNPARSER_SHA256=   # needed with a custom URL or another version (M3); 1.15.0 checksums are built in.
#                     Must match the platform built (amd64 = linux-x86, arm64 = linux-arm)
GNPARSER_VERSION=1.15.0
# https://github.com/gnames/gnparser/releases/download/v1.15.0/gnparser-v1.15.0-linux-x86.tar.gz
# https://github.com/gnames/gnparser/releases/download/v1.15.0/gnparser-v1.15.0-linux-arm.tar.gz
# Force amd64 build on mixed hosts (e.g. testing the RHEL build on an Apple Silicon Mac):
#   DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose -f docker-compose.yml build
# ------------------------------------------------------------------------------
# Neo4j
# docker-compose.yml has NO neo4j service (it is Mac dev only, in the override file).
# On RHEL only NEO_URI / NEO_USERNAME / NEO_PASSWORD / NEO_DATABASE are used — passed to jenkins
# for Python jobs. The other NEO_* / PATH_NEO4J_* / PORT_* values are unused unless a
# neo4j service is added; its ports are pre-bound to 127.0.0.1 for that case.
NEO_URI=bolt://neo4j:7687 # 7687 Connect to Neo4j service by its name
NEO_USERNAME=neo4j
NEO_PASSWORD=CHANGE_ME_neo4j_password
NEO_DATABASE=neo4j
PATH_NEO4J_DATA=/opt/eol/neo4j/data
PATH_NEO4J_LOGS=/opt/eol/neo4j/logs
PATH_NEO4J_IMPORT=/opt/eol/neo4j/import
PATH_NEO4J_IMPORT2=/opt/eol/neo4j/import2
PATH_NEO4J_PLUGINS=/opt/eol/neo4j/plugins

# --- Neo4j memory tuning (Layer 2 stability) ---
# NOTE: named NEO_* (NOT NEO4J_*) on purpose — env_file injects every var into the
# container, and Neo4j's entrypoint would misread a NEO4J_* name as an (invalid)
# config key and refuse to start. These are used only for compose interpolation
# into the NEO4J_server_memory_* settings of the neo4j service (docker-compose.override.yml).
# heap + pagecache + ~1G JVM overhead must stay UNDER NEO_MEM_LIMIT.
# Tune for server RAM; values below match a typical 16G+ host.
NEO_HEAP_INIT=2G
NEO_HEAP_MAX=4G
NEO_PAGECACHE=2G
NEO_TX_TOTAL_MAX=2G
# Hard container memory cap so Neo4j can't OOM the host.
NEO_MEM_LIMIT=8g

# If Neo4j is ever run on RHEL (testing only, not public): both ports bound to localhost; use an SSH tunnel.
PORT_7474=127.0.0.1:7474:7474
# Port 7474 is used to access the Neo4j Browser, which is a web-based tool for interacting with your Neo4j database, running Cypher queries, and visualizing your graph data.
# Access via SSH tunnel (ssh -L 7474:127.0.0.1:7474 -L 7687:127.0.0.1:7687 <user>@<server>), then http://localhost:7474/browser

PORT_7687=127.0.0.1:7687:7687
# Neo4j utilizes port 7687 as the default port for the Bolt protocol. The Bolt protocol is the primary communication protocol for interacting with Neo4j instances, used by Neo4j drivers, Neo4j Browser, and Neo4j Bloom for programmatic and graphical access to the database.
# When connecting to a Neo4j database, whether locally or remotely, the connection URL typically includes bolt://hostname:7687 (or neo4j://hostname:7687 for routing-aware drivers in a cluster). This port facilitates the secure and efficient transfer of data and commands between client applications and the Neo4j database.
# If troubleshooting connection issues, ensuring that port 7687 is open and accessible through firewalls is crucial. Additionally, if Neo4j is configured to listen on a different port, that custom port must be specified in the connection string.
# ------------------------------------------------------------------------------
# Python
PYTHON_APP=/opt/eol/python_projects
# ------------------------------------------------------------------------------
# --- image: ${REGISTRY}/${REGISTRY_DB_IMAGE}:${REGISTRY_DB_TAG}
# --- image: docker.io/eagbayani/db-service:1.0
# REGISTRY=docker.io
# REGISTRY_DB_IMAGE=eagbayani/db-service
# REGISTRY_DB_TAG=1.0
# REGISTRY_WEB_IMAGE=eagbayani/web-service
# REGISTRY_WEB_TAG=1.0
# REGISTRY_JENKINS_IMAGE=eagbayani/jenkins-service
# REGISTRY_JENKINS_TAG=1.0

# --- image: ghcr.io/eliagbayani/db-service:latest
# REGISTRY=ghcr.io
# REGISTRY_DB_IMAGE=eliagbayani/db-service
# REGISTRY_DB_TAG=latest
# REGISTRY_WEB_IMAGE=eliagbayani/web-service
# REGISTRY_WEB_TAG=latest
# REGISTRY_JENKINS_IMAGE=eliagbayani/jenkins-service
# REGISTRY_JENKINS_TAG=latest
# ------------------------------------------------------------------------------
