# ==============================================================================
# EOL Connectors — Mac development .env
# ==============================================================================
# Copy to .env in the project root:
#   cp .env.sample .env
#
# Requires local docker-compose.override.yml (gitignored) mounting /Volumes.
#   docker compose up -d   # merges override automatically on Mac
# ==============================================================================

# ------------------------------------------------------------------------------
# For EOL PHP 8 codebase: eol_php8_code
# Environment is either development or production
MY_ENVIRONMENT=development
# VOLUMES_LOCAL=/Volumes
EXTRA_PATH=/Volumes/OWC_Express/other_files/My_Docker_content/extra
# ------------------------------------------------------------------------------
# MySQL
MYSQL_ROOT_PASSWORD=root_pw
MYSQL_USER=eagbayani
MYSQL_PASSWORD=app_user_pw
MYSQL_DATA_DIR=/Volumes/OWC_Express/other_files/My_Docker_content/mysql_data
MYSQL_PORTS=4001:3306
# ------------------------------------------------------------------------------
# Apache
WEBROOT_PATH=/Volumes/OWC_Express/other_files/My_Docker_content/webroot
APACHE_LOGS=/Volumes/OWC_Express/other_files/My_Docker_content/apache2_logs
WEB_PORTS=81:80             # PHP test page: http://localhost:81/test.php | in eol-archive use 80:80
# ------------------------------------------------------------------------------
# Jenkins
# Host bind-mount paths (do not name these JENKINS_HOME — that env var is reserved inside the container)
PATH_JENKINS_TMP=/Volumes/OWC_Express/other_files/My_Docker_content/jenkins_tmp
PATH_JENKINS_HOME=/Volumes/OWC_Express/other_files/My_Docker_content/jenkins_home
JENKINS_PORTS=8081:8080                 # Jenkins home page: http://localhost:8081 | in eol-archive use 8090:8080 -> http://160.111.248.39:8090
JENKINS_PORTS_COMMUNICATION=50000:50000 # Jenkins default port for communication
# ------------------------------------------------------------------------------
# Optional override of full download URL (leave empty for auto):
# GNPARSER_URL=
GNPARSER_VERSION=1.15.0
# https://github.com/gnames/gnparser/releases/download/v1.15.0/gnparser-v1.15.0-linux-x86.tar.gz
# https://github.com/gnames/gnparser/releases/download/v1.15.0/gnparser-v1.15.0-linux-arm.tar.gz
# ------------------------------------------------------------------------------
# Neo4j
NEO_URI=bolt://neo4j:7687 # 7687 Connect to Neo4j service by its name
NEO_USERNAME=neo4j
NEO_PASSWORD=neo4j_password
NEO_DATABASE=neo4j
# Legacy Enterprise database name was db.eol — Community Edition uses neo4j only
PATH_NEO4J_DATA=/Volumes/OWC_Express/other_files/My_Docker_content/neo4j/data
PATH_NEO4J_LOGS=/Volumes/OWC_Express/other_files/My_Docker_content/neo4j/logs
PATH_NEO4J_IMPORT=/Volumes/OWC_Express/other_files/My_Docker_content/neo4j/import
# PATH_NEO4J_IMPORT2=/Volumes/Crucial_2TB/resources_3/neo4j_imports
PATH_NEO4J_IMPORT2=/Volumes/Crucial_2TB/eol_resources/neo4j_imports
PATH_NEO4J_PLUGINS=/Volumes/OWC_Express/other_files/My_Docker_content/neo4j/plugins

# --- Neo4j memory tuning (Layer 2 stability) ---
# NOTE: named NEO_* (NOT NEO4J_*) on purpose — env_file injects every var into the
# container, and Neo4j's entrypoint would misread a NEO4J_* name as an (invalid)
# config key and refuse to start. These are used only for compose interpolation
# into the NEO4J_server_memory_* settings in docker-compose.yml.
# heap + pagecache + ~1G JVM overhead must stay UNDER NEO_MEM_LIMIT.
# Tune up if the Docker Desktop VM has spare RAM and fewer co-tenants.
NEO_HEAP_INIT=2G
NEO_HEAP_MAX=4G
NEO_PAGECACHE=2G
NEO_TX_TOTAL_MAX=2G
# Hard container memory cap so Neo4j can't OOM the whole Docker Desktop VM.
NEO_MEM_LIMIT=8g

PORT_7474=7494:7474
# Port 7474 is used to access the Neo4j Browser, which is a web-based tool for interacting with your Neo4j database, running Cypher queries, and visualizing your graph data.
# With the mapping above, use http://localhost:7494/browser in your web browser.

PORT_7687=7697:7687
# Neo4j utilizes port 7687 as the default port for the Bolt protocol. The Bolt protocol is the primary communication protocol for interacting with Neo4j instances, used by Neo4j drivers, Neo4j Browser, and Neo4j Bloom for programmatic and graphical access to the database.
# When connecting to a Neo4j database, whether locally or remotely, the connection URL typically includes bolt://hostname:7687 (or neo4j://hostname:7687 for routing-aware drivers in a cluster). This port facilitates the secure and efficient transfer of data and commands between client applications and the Neo4j database.
# If troubleshooting connection issues, ensuring that port 7687 is open and accessible through firewalls is crucial. Additionally, if Neo4j is configured to listen on a different port, that custom port must be specified in the connection string.
# External drives (e.g. Crucial_2TB) must be enabled in Docker Desktop → Settings → File sharing.
# ------------------------------------------------------------------------------
# Python
PYTHON_APP=/Volumes/OWC_Express/other_files/My_Docker_content/python_projects
# ------------------------------------------------------------------------------
